name = "moonbitstack/moonfory"

version = "0.1.4"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfory"

license = "Apache-2.0"

keywords = [
  "fory",
  "apache-fory",
  "fury",
  "serialization",
  "deserialize",
  "serializer",
  "marshal",
  "binary",
  "binary-format",
  "data-format",
  "cross-language",
  "xlang",
  "interop",
  "row-format",
  "object-graph",
  "schema",
  "struct",
  "codec",
  "moonbit",
]

description = "The Fory cross-language binary format for MoonBit."

import {
  "moonbitstack/moonvar@0.2.2",
  "moonbitstack/moondate@0.1.6",
  "moonbitstack/moonmodel@0.1.4",
  "moonbitstack/moonbase@0.4.4",
}

source = "src"
