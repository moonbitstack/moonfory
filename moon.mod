name = "moonbitstack/moonfory"

version = "0.1.3"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonfory"

license = "Apache-2.0"

keywords = [
  "fory",
  "apache-fory",
  "fury",
  "serialization",
  "binary",
  "cross-language",
  "xlang",
  "row-format",
  "codec",
  "moonbit",
]

description = "The Fory cross-language binary format for MoonBit."

import {
  "moonbitstack/moonvar@0.2.1",
  "moonbitstack/moondate@0.1.4",
  "moonbitstack/moonmodel@0.1.3",
  "moonbitstack/moonbase@0.4.3",
}

source = "src"
